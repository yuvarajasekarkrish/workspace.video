# Settings for the app box. Copy to .env on the server (chmod 600) and fill in.
# This file holds NO real secrets; never commit a filled-in copy.
# Generate each secret separately:  openssl rand -hex 32
# In production the apps refuse to start on a missing, blank or public-default value.

NODE_ENV=production

# Public address of this environment, without https://
APP_ADDRESS=www.workspace.video
APP_URL=https://www.workspace.video
# The browser is sent here for the live socket: the same address, through the proxy.
REALTIME_PUBLIC_URL=https://www.workspace.video

# Three DIFFERENT secrets
AUTH_SECRET=
REALTIME_JWT_SECRET=
INTERNAL_METRICS_TOKEN=

# Database. Managed Postgres: paste its address here.
# Single-machine pilot (docker-compose.pilot.yml): use the values below, with the same
# user, password and name in POSTGRES_* and in DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@host.docker.internal:5432/DBNAME
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Redis runs in this stack
REDIS_URL=redis://redis:6379

# Sign-in email (Resend). MAIL_FROM must be on the domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM=workspace.video <login@mail.workspace.video>

# Optional public links. A link with no address is not shown on the site.
DEMO_URL=
CONTACT_EMAIL=
SOCIAL_X_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_LINKEDIN_URL=

# Media server. Pilot: runs on this machine at MEDIA_ADDRESS; otherwise its own machine.
MEDIA_ADDRESS=media.workspace.video
LIVEKIT_URL=wss://media.workspace.video
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Set by the deploy script or your shell, not stored here:
# REGISTRY=registry.example.com/workspace-video
# IMAGE_TAG=<commit id>

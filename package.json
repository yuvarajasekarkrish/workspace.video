{
  "name": "cosmos-workspace",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "pnpm --parallel -r --filter=./apps/* run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "db:migrate": "pnpm --filter @cosmos/db run migrate",
    "db:generate": "pnpm --filter @cosmos/db run generate"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=20"
  }
}
